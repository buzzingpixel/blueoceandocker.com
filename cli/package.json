{
    "name": "blue-ocean-docker-cli",
    "description": "Blue Ocean Docker CLI",
    "author": "TJ Draper",
    "bin": {
        "cli": "./bin/run"
    },
    "license": "UNLICENSED",
    "private": true,
    "main": "dist/index.js",
    "files": [
        "/bin",
        "/dist",
        "/npm-shrinkwrap.json",
        "/oclif.manifest.json"
    ],
    "dependencies": {
        "@oclif/core": "^5.1.12",
        "@oclif/plugin-commands": "^5.0.13",
        "@oclif/plugin-help": "^7.0.10",
        "chalk": "^4.1.2",
        "fs-extra": "^11.4.1"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^26.6.6",
        "ts-node": "^10.9.2",
        "tslib": "^2.9.1",
        "typescript": "^5.9.3"
    },
    "oclif": {
        "bin": "./dev",
        "dirname": "cli",
        "commands": "./dist/commands",
        "plugins": [
            "@oclif/plugin-help",
            "@oclif/plugin-commands"
        ],
        "topicSeparator": " ",
        "topics": {}
    },
    "scripts": {
        "build": "rm -rf dist && yarn tsc -b"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "types": "dist/index.d.ts"
}
