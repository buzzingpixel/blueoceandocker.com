{
    "include": [
        "src/**/*"
    ],
    "compilerOptions": {
        "declaration": true,
        "importHelpers": true,
        "module": "commonjs",
        "outDir": "dist",
        "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
        "rootDir": "src",
        "strict": true,
        "target": "es2019",
        "esModuleInterop": true
    }
}
